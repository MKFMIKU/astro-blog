---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<nav aria-label="Primary navigation">
		<a class="wordmark" href="/" aria-label="Kang-Fu Mei Research Notes home">
			<span class="mark">KFM</span>
			<span class="name">Research Notes</span>
		</a>
		<div class="nav-links">
			<HeaderLink href="/">Research</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<a href="/rss.xml">RSS</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: relative;
		z-index: 10;
		border-bottom: 1px solid var(--line);
		background: color-mix(in srgb, var(--paper) 92%, transparent);
	}
	nav {
		display: flex;
		width: min(100%, var(--page));
		min-height: 76px;
		margin: 0 auto;
		padding: 0 var(--gutter);
		align-items: center;
		justify-content: space-between;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	.mark {
		display: grid;
		width: 2.35rem;
		height: 2.35rem;
		place-items: center;
		background: var(--ink);
		border-radius: 50%;
		color: var(--paper);
		font-size: 0.72rem;
		letter-spacing: -0.02em;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2.5rem);
	}
	.nav-links a {
		padding: 1.65rem 0;
		border-bottom: 2px solid transparent;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
	}
	.nav-links a.active {
		border-bottom-color: var(--signal);
		color: var(--signal);
	}
	@media (max-width: 600px) {
		nav {
			min-height: 64px;
		}
		.name,
		.nav-links a:last-child {
			display: none;
		}
	}
</style>
