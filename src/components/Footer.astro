---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div>
			<p class="footer-mark">KFM / Research Notes</p>
			<p class="footer-copy">Ideas at the edge of generative AI, media, and society.</p>
		</div>
		<div class="footer-links">
			<a href="https://kfmei.com">Research website ↗</a>
			<a href="https://scholar.google.com/citations?hl=en&user=e_nu_TIAAAAJ">Scholar ↗</a>
			<a href="https://github.com/MKFMIKU">GitHub ↗</a>
		</div>
		<p class="copyright">© {today.getFullYear()} Kang-Fu Mei</p>
	</div>
</footer>

<style>
	footer {
		margin-top: clamp(5rem, 10vw, 10rem);
		border-top: 1px solid var(--line);
	}
	.footer-inner {
		display: grid;
		width: min(100%, var(--page));
		margin: 0 auto;
		padding: 3rem var(--gutter) 4rem;
		grid-template-columns: 2fr 1fr auto;
		gap: 3rem;
		align-items: start;
	}
	.footer-mark {
		margin: 0 0 0.4rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.footer-copy,
	.copyright {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.85rem;
	}
	.footer-links {
		display: grid;
		gap: 0.35rem;
	}
	.footer-links a {
		font-size: 0.85rem;
		text-decoration: none;
	}
	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
