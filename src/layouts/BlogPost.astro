---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<p class="eyebrow">Essay · Culture & AI</p>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					<div class="article-byline">
						<div>
							<span>Written by</span>
							<strong>Kang-Fu Mei</strong>
						</div>
						<div>
							<span>Published</span>
							<strong><FormattedDate date={pubDate} /></strong>
						</div>
						<div>
							<span>Reading time</span>
							<strong>8 minutes</strong>
						</div>
					</div>
					{updatedDate && <p class="updated">Updated <FormattedDate date={updatedDate} /></p>}
				</header>

				{heroImage && (
					<figure class="hero-image">
						<img width={1774} height={887} src={heroImage} alt={`Illustration for ${title}`} />
						<figcaption>Exploring the changing relationship between virtual characters, creative tools, and social life.</figcaption>
					</figure>
				)}

				<div class="article-grid">
					<aside aria-label="Article details">
						<p>Research note</p>
						<span>01 / 2026</span>
						<div class="aside-rule"></div>
						<p>Topics</p>
						<span>Generative media<br />Virtual worlds<br />AI & society</span>
					</aside>
					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-header {
		width: min(100%, var(--page));
		margin: 0 auto;
		padding: clamp(4rem, 9vw, 8rem) var(--gutter) clamp(3.5rem, 7vw, 6rem);
	}
	.article-header h1 {
		max-width: 1200px;
		margin-top: 2rem;
		font-size: clamp(3.8rem, 8vw, 8.5rem);
		line-height: 0.9;
	}
	.dek {
		max-width: 820px;
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
		color: var(--ink-soft);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.35rem, 2.2vw, 2rem);
		line-height: 1.35;
	}
	.article-byline {
		display: flex;
		max-width: 820px;
		margin-top: clamp(3rem, 6vw, 5.5rem);
		padding-top: 1rem;
		border-top: 1px solid var(--ink);
		gap: clamp(2rem, 6vw, 6rem);
	}
	.article-byline div {
		display: grid;
		gap: 0.15rem;
	}
	.article-byline span,
	.updated {
		color: var(--ink-soft);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.article-byline strong {
		font-size: 0.86rem;
		font-weight: 400;
	}
	.updated {
		margin-top: 1rem;
	}
	.hero-image {
		width: min(calc(100% - 2 * var(--gutter)), var(--page));
		margin: 0 auto;
	}
	.hero-image img {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
	.hero-image figcaption {
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--ink-soft);
		font-size: 0.75rem;
	}
	.article-grid {
		display: grid;
		width: min(100%, 1180px);
		margin: 0 auto;
		padding: clamp(4rem, 9vw, 8rem) var(--gutter) 0;
		grid-template-columns: 170px minmax(0, 760px);
		gap: clamp(3rem, 8vw, 9rem);
	}
	aside {
		font-size: 0.72rem;
		line-height: 1.55;
	}
	aside p {
		margin: 0 0 0.25rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	aside span {
		color: var(--ink-soft);
	}
	.aside-rule {
		width: 100%;
		margin: 1.25rem 0;
		border-top: 1px solid var(--line);
	}
	.prose {
		min-width: 0;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.15rem, 1.5vw, 1.3rem);
		line-height: 1.72;
	}
	.prose :global(> p:first-child) {
		font-size: 1.25em;
		line-height: 1.5;
	}
	.prose :global(> p:first-child::first-letter) {
		float: left;
		margin: 0.08em 0.08em 0 0;
		color: var(--signal);
		font-family: "Atkinson", sans-serif;
		font-size: 4.1em;
		font-weight: 700;
		line-height: 0.78;
	}
	.prose :global(h2) {
		margin: 4.5rem 0 1.6rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-family: "Atkinson", sans-serif;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		line-height: 1;
	}
	.prose :global(h3) {
		margin: 3rem 0 1rem;
		font-family: "Atkinson", sans-serif;
		font-size: 1.35rem;
		font-weight: 700;
	}
	.prose :global(p) {
		margin-bottom: 1.6em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 1.5rem 0 2.5rem;
		padding-left: 1.2rem;
	}
	.prose :global(li) {
		margin-bottom: 0.65rem;
		padding-left: 0.4rem;
	}
	.prose :global(img) {
		width: calc(100% + min(16vw, 12rem));
		max-width: none;
		margin: 4rem 0 1rem calc(min(8vw, 6rem) * -1);
	}
	.prose :global(img + em) {
		display: block;
		margin: 0 0 4rem;
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		font-style: normal;
		line-height: 1.45;
	}
	.prose :global(.miku-context-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: clamp(1.25rem, 3vw, 2.75rem);
		width: calc(100% + min(16vw, 12rem));
		margin: 3.25rem 0 4rem calc(min(8vw, 6rem) * -1);
		padding: clamp(1.25rem, 3vw, 2.5rem);
		background: #e9e9e3;
	}
	.prose :global(.miku-context-grid figure) {
		display: grid;
		grid-template-rows: clamp(26rem, 38vw, 36rem) auto;
		margin: 0;
	}
	.prose :global(.miku-context-grid img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		margin: 0 0 1rem;
		object-fit: contain;
		object-position: center center;
	}
	.prose :global(.miku-character img) {
		width: 80%;
		max-height: none;
		margin-right: auto;
		margin-left: auto;
	}
	.prose :global(.miku-software img) {
		width: 100%;
		image-rendering: auto;
	}
	.prose :global(.miku-context-grid figcaption) {
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.miku-context-grid figcaption a) {
		color: inherit;
	}
	.prose :global(.archive-figure) {
		width: min(100%, 34rem);
		margin: 3rem auto 4rem;
	}
	.prose :global(.archive-figure img) {
		display: block;
		width: 100%;
		max-width: 100%;
		margin: 0 0 1rem;
	}
	.prose :global(.archive-figure figcaption) {
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.archive-figure figcaption a) {
		color: inherit;
	}
	.prose :global(.human-star-lineup) {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.65rem;
		width: calc(100% + min(24vw, 18rem));
		margin: 3rem 0 4rem calc(min(12vw, 9rem) * -1);
	}
	.prose :global(.human-star-lineup figure) {
		margin: 0;
	}
	.prose :global(.human-star-lineup img) {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		margin: 0 0 0.85rem;
		object-fit: cover;
		object-position: center top;
	}
	.prose :global(.human-star-lineup figcaption) {
		font-family: "Atkinson", sans-serif;
		font-size: 0.68rem;
		line-height: 1.35;
	}
	.prose :global(.human-star-lineup strong),
	.prose :global(.human-star-lineup span),
	.prose :global(.human-star-lineup figcaption a) {
		display: block;
	}
	.prose :global(.human-star-lineup strong) {
		color: var(--ink);
		font-size: 0.8rem;
	}
	.prose :global(.human-star-lineup span) {
		margin: 0.12rem 0 0.5rem;
		color: var(--signal);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.prose :global(.human-star-lineup figcaption a) {
		color: var(--ink-soft);
	}
	.prose :global(.yuri-case-media) {
		width: calc(100% + min(16vw, 12rem));
		margin: 3.25rem 0 4rem calc(min(8vw, 6rem) * -1);
	}
	.prose :global(.yuri-case-media figcaption) {
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.yuri-case-media figcaption a) {
		color: inherit;
	}
	.prose :global(.miku-concert) {
		width: calc(100% + min(12vw, 9rem));
		margin: 3.25rem 0 4rem calc(min(6vw, 4.5rem) * -1);
	}
	.prose :global(.miku-concert .video-link-card),
	.prose :global(.yuri-case-media .video-link-card) {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #111;
	}
	.prose :global(.miku-concert .video-link-card img),
	.prose :global(.yuri-case-media .video-link-card img) {
		width: 100%;
		height: 100%;
		margin: 0;
		object-fit: cover;
		transition: transform 220ms ease, filter 220ms ease;
	}
	.prose :global(.miku-concert .video-link-card:hover img),
	.prose :global(.yuri-case-media .video-link-card:hover img) {
		transform: scale(1.015);
		filter: brightness(0.82);
	}
	.prose :global(.miku-concert .play-button),
	.prose :global(.yuri-case-media .play-button) {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: 4.5rem;
		height: 4.5rem;
		place-items: center;
		padding-left: 0.25rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: rgba(244, 244, 239, 0.94);
		color: var(--ink);
		font-family: "Atkinson", sans-serif;
		font-size: 1.35rem;
	}
	.prose :global(.miku-concert .watch-label),
	.prose :global(.yuri-case-media .watch-label) {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.55rem 0.75rem;
		background: rgba(15, 15, 14, 0.84);
		color: #fff;
		font-family: "Atkinson", sans-serif;
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}
	.prose :global(.miku-concert figcaption) {
		margin-top: 0.85rem;
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.miku-concert figcaption a) {
		color: inherit;
	}
	.prose :global(a) {
		text-decoration-color: var(--signal);
	}
	@media (max-width: 800px) {
		.article-grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		aside {
			display: none;
		}
		.article-byline {
			flex-wrap: wrap;
		}
		.prose :global(img) {
			width: 100%;
			margin-left: 0;
		}
		.prose :global(.miku-context-grid) {
			width: 100%;
			margin-left: 0;
		}
		.prose :global(.human-star-lineup) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem 0.75rem;
			width: 100%;
			margin-left: 0;
		}
		.prose :global(.yuri-case-media) {
			width: 100%;
			margin-left: 0;
		}
		.prose :global(.miku-concert) {
			width: 100%;
			margin-left: 0;
		}
	}
	@media (max-width: 600px) {
		.article-header h1 {
			font-size: clamp(3.1rem, 16vw, 5rem);
		}
		.article-byline {
			gap: 1.5rem 2.5rem;
		}
		.prose :global(.miku-context-grid) {
			grid-template-columns: 1fr;
		}
		.prose :global(.miku-character img) {
			width: 80%;
			max-height: none;
		}
		.prose :global(.miku-context-grid figure) {
			grid-template-rows: auto auto;
		}
		.prose :global(.miku-context-grid img) {
			height: auto;
			max-height: 30rem;
		}
	}
</style>
