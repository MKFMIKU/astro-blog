---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="article-header">
					<p class="eyebrow">Essay · Culture & AI</p>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					<div class="article-byline">
						<div>
							<span>Written by</span>
							<strong>Kang-Fu Mei</strong>
						</div>
						<div>
							<span>Published</span>
							<strong><FormattedDate date={pubDate} /></strong>
						</div>
						<div>
							<span>Reading time</span>
							<strong>8 minutes</strong>
						</div>
					</div>
					{updatedDate && <p class="updated">Updated <FormattedDate date={updatedDate} /></p>}
				</header>

				{heroImage && (
					<figure class="hero-image">
						<img width={1774} height={887} src={heroImage} alt={`Illustration for ${title}`} />
						<figcaption>Exploring the changing relationship between virtual characters, creative tools, and social life.</figcaption>
					</figure>
				)}

				<div class="article-grid">
					<aside aria-label="Article details">
						<p>Research note</p>
						<span>01 / 2026</span>
						<div class="aside-rule"></div>
						<p>Topics</p>
						<span>Generative media<br />Virtual worlds<br />AI & society</span>
					</aside>
					<div class="prose">
						<slot />
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.article-header {
		width: min(100%, var(--page));
		margin: 0 auto;
		padding: clamp(4rem, 9vw, 8rem) var(--gutter) clamp(3.5rem, 7vw, 6rem);
	}
	.article-header h1 {
		max-width: 1200px;
		margin-top: 2rem;
		font-size: clamp(3.8rem, 8vw, 8.5rem);
		line-height: 0.9;
	}
	.dek {
		max-width: 820px;
		margin: clamp(2rem, 4vw, 3.5rem) 0 0;
		color: var(--ink-soft);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.35rem, 2.2vw, 2rem);
		line-height: 1.35;
	}
	.article-byline {
		display: flex;
		max-width: 820px;
		margin-top: clamp(3rem, 6vw, 5.5rem);
		padding-top: 1rem;
		border-top: 1px solid var(--ink);
		gap: clamp(2rem, 6vw, 6rem);
	}
	.article-byline div {
		display: grid;
		gap: 0.15rem;
	}
	.article-byline span,
	.updated {
		color: var(--ink-soft);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.article-byline strong {
		font-size: 0.86rem;
		font-weight: 400;
	}
	.updated {
		margin-top: 1rem;
	}
	.hero-image {
		width: min(calc(100% - 2 * var(--gutter)), var(--page));
		margin: 0 auto;
	}
	.hero-image img {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
	}
	.hero-image figcaption {
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--line);
		color: var(--ink-soft);
		font-size: 0.75rem;
	}
	.article-grid {
		display: grid;
		width: min(100%, 1180px);
		margin: 0 auto;
		padding: clamp(4rem, 9vw, 8rem) var(--gutter) 0;
		grid-template-columns: 170px minmax(0, 760px);
		gap: clamp(3rem, 8vw, 9rem);
	}
	aside {
		font-size: 0.72rem;
		line-height: 1.55;
	}
	aside p {
		margin: 0 0 0.25rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	aside span {
		color: var(--ink-soft);
	}
	.aside-rule {
		width: 100%;
		margin: 1.25rem 0;
		border-top: 1px solid var(--line);
	}
	.prose {
		min-width: 0;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.15rem, 1.5vw, 1.3rem);
		line-height: 1.72;
	}
	.prose :global(> p:first-child) {
		font-size: 1.25em;
		line-height: 1.5;
	}
	.prose :global(> p:first-child::first-letter) {
		float: left;
		margin: 0.08em 0.08em 0 0;
		color: var(--signal);
		font-family: "Atkinson", sans-serif;
		font-size: 4.1em;
		font-weight: 700;
		line-height: 0.78;
	}
	.prose :global(h2) {
		margin: 4.5rem 0 1.6rem;
		padding-top: 1rem;
		border-top: 1px solid var(--line);
		font-family: "Atkinson", sans-serif;
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		line-height: 1;
	}
	.prose :global(h3) {
		margin: 3rem 0 1rem;
		font-family: "Atkinson", sans-serif;
		font-size: 1.35rem;
		font-weight: 700;
	}
	.prose :global(p) {
		margin-bottom: 1.6em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		margin: 1.5rem 0 2.5rem;
		padding-left: 1.2rem;
	}
	.prose :global(li) {
		margin-bottom: 0.65rem;
		padding-left: 0.4rem;
	}
	.prose :global(img) {
		width: calc(100% + min(16vw, 12rem));
		max-width: none;
		margin: 4rem 0 1rem calc(min(8vw, 6rem) * -1);
	}
	.prose :global(img + em) {
		display: block;
		margin: 0 0 4rem;
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		font-style: normal;
		line-height: 1.45;
	}
	.prose :global(.star-evolution) {
		--diagram-ink: #171916;
		--diagram-paper: #e9e9e3;
		--diagram-line: rgba(23, 25, 22, 0.2);
		width: calc(100% + min(28vw, 21rem));
		margin: 4.5rem 0 6rem calc(min(14vw, 10.5rem) * -1);
		padding: clamp(1.4rem, 3vw, 2.5rem);
		background: var(--diagram-paper);
		color: var(--diagram-ink);
		font-family: "Atkinson", sans-serif;
	}
	.prose :global(.evolution-heading) {
		display: grid;
		grid-template-columns: minmax(8rem, 0.65fr) 2fr;
		align-items: end;
		gap: 1.5rem;
		padding-bottom: 1.4rem;
		border-bottom: 1px solid var(--diagram-line);
	}
	.prose :global(.evolution-heading span) {
		color: var(--signal);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}
	.prose :global(.evolution-heading strong) {
		max-width: 31rem;
		font-size: clamp(1.45rem, 2.6vw, 2.4rem);
		font-weight: 700;
		letter-spacing: -0.025em;
		line-height: 1.05;
	}
	.prose :global(.evolution-track) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 1.4rem minmax(0, 1fr) 1.4rem minmax(0, 1fr) 1.4rem minmax(0, 1fr);
		gap: 0.4rem;
		padding: 2rem 0 1.25rem;
	}
	.prose :global(.evolution-stage) {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		margin: 0;
		animation: stage-arrive 700ms both;
	}
	.prose :global(.evolution-stage:nth-of-type(2)) { animation-delay: 130ms; }
	.prose :global(.evolution-stage:nth-of-type(3)) { animation-delay: 260ms; }
	.prose :global(.evolution-stage:nth-of-type(4)) { animation-delay: 390ms; }
	.prose :global(.stage-index) {
		position: absolute;
		top: 0.55rem;
		left: 0.55rem;
		z-index: 2;
		padding: 0.22rem 0.34rem;
		background: rgba(244, 244, 239, 0.9);
		font-size: 0.61rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.prose :global(.stage-portrait) {
		position: relative;
		display: grid;
		aspect-ratio: 4 / 5;
		place-items: center;
		overflow: hidden;
		background: #d5d7d0;
	}
	.prose :global(.stage-portrait::after) {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(23, 25, 22, 0.12);
		content: "";
		pointer-events: none;
	}
	.prose :global(.stage-portrait img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: none;
		margin: 0;
		object-fit: cover;
		transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.prose :global(.evolution-stage:hover .stage-portrait img) { transform: scale(1.035); }
	.prose :global(.miku-stage .stage-portrait img) {
		width: 84%;
		height: 92%;
		object-fit: contain;
		object-position: center bottom;
	}
	.prose :global(.yuri-stage .stage-portrait img) { object-position: 56% center; }
	.prose :global(.future-portrait) {
		isolation: isolate;
		background: #111813;
	}
	.prose :global(.future-portrait::before) {
		position: absolute;
		width: 72%;
		aspect-ratio: 1;
		border: 1px solid rgba(143, 229, 175, 0.45);
		border-radius: 50%;
		box-shadow: 0 0 4rem rgba(71, 201, 119, 0.22);
		content: "";
		animation: core-breathe 3.2s ease-in-out infinite;
	}
	.prose :global(.future-orbit) {
		position: absolute;
		width: 58%;
		aspect-ratio: 1;
		border: 1px dashed rgba(244, 244, 239, 0.45);
		border-radius: 50%;
		animation: orbit-turn 12s linear infinite;
	}
	.prose :global(.future-orbit::after) {
		position: absolute;
		top: -0.22rem;
		left: 50%;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #8fe5af;
		content: "";
		box-shadow: 0 0 1rem #8fe5af;
	}
	.prose :global(.future-core) {
		position: relative;
		z-index: 1;
		color: #f4f4ef;
		font-size: clamp(2rem, 4vw, 3.3rem);
		font-weight: 700;
		letter-spacing: -0.07em;
	}
	.prose :global(.stage-era) {
		margin: 1rem 0 0.45rem;
		color: var(--signal);
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.2;
		text-transform: uppercase;
	}
	.prose :global(.evolution-stage h3) {
		margin: 0 0 1rem;
		font-size: clamp(1.05rem, 1.55vw, 1.35rem);
		line-height: 1.04;
	}
	.prose :global(.stage-gives),
	.prose :global(.stage-missing) {
		margin: 0 0 0.8rem;
		font-size: 0.73rem;
		line-height: 1.42;
	}
	.prose :global(.stage-gives span),
	.prose :global(.stage-missing span) {
		display: block;
		margin-bottom: 0.15rem;
		font-size: 0.58rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}
	.prose :global(.stage-missing) { color: #686b65; }
	.prose :global(.capability-line) {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.2rem;
		margin-top: auto;
		padding-top: 0.65rem;
	}
	.prose :global(.capability-line i) {
		height: 0.24rem;
		background: rgba(23, 25, 22, 0.14);
	}
	.prose :global(.capability-line i.on) {
		background: var(--signal);
		animation: capability-on 650ms both;
		animation-delay: 520ms;
	}
	.prose :global(.evolution-arrow) {
		display: flex;
		align-items: calc(20% + 1rem);
		padding-top: 7rem;
	}
	.prose :global(.evolution-arrow span) {
		position: relative;
		display: block;
		width: 100%;
		height: 1px;
		overflow: visible;
		background: var(--diagram-line);
	}
	.prose :global(.evolution-arrow span::before) {
		position: absolute;
		top: -2px;
		left: 0;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--signal);
		content: "";
		animation: flow-right 2.4s ease-in-out infinite;
	}
	.prose :global(.evolution-arrow span::after) {
		position: absolute;
		top: -3px;
		right: 0;
		width: 6px;
		height: 6px;
		transform: rotate(45deg);
		border-top: 1px solid var(--diagram-ink);
		border-right: 1px solid var(--diagram-ink);
		content: "";
	}
	.prose :global(.capability-key) {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.4rem;
		margin: 0 0 1.35rem;
		padding: 0.85rem 0;
		border-top: 1px solid var(--diagram-line);
		border-bottom: 1px solid var(--diagram-line);
		font-size: 0.59rem;
		letter-spacing: 0.05em;
		text-align: center;
		text-transform: uppercase;
	}
	.prose :global(.star-evolution figcaption) {
		max-width: 48rem;
		color: #5a5d57;
		font-size: 0.72rem;
		line-height: 1.5;
	}
	@keyframes stage-arrive {
		from { opacity: 0; transform: translateY(0.8rem); }
		to { opacity: 1; transform: translateY(0); }
	}
	@keyframes capability-on {
		from { transform: scaleX(0); transform-origin: left; }
		to { transform: scaleX(1); transform-origin: left; }
	}
	@keyframes flow-right {
		0% { opacity: 0; transform: translateX(0); }
		25% { opacity: 1; }
		75% { opacity: 1; }
		100% { opacity: 0; transform: translateX(1.05rem); }
	}
	@keyframes orbit-turn { to { transform: rotate(360deg); } }
	@keyframes core-breathe {
		50% { transform: scale(1.05); border-color: rgba(143, 229, 175, 0.8); }
	}
	@supports (animation-timeline: view()) {
		.prose :global(.evolution-stage) {
			animation-timeline: view();
			animation-range: entry 8% cover 32%;
		}
	}
	.prose :global(.creative-surface-diagram) {
		width: calc(100% + min(20vw, 15rem));
		margin: 4rem 0 4.5rem calc(min(10vw, 7.5rem) * -1);
		padding: clamp(1.25rem, 2.6vw, 2.25rem);
		border-top: 1px solid var(--ink);
		border-bottom: 1px solid var(--line);
		font-family: "Atkinson", sans-serif;
	}
	.prose :global(.diagram-kicker) {
		margin-bottom: 1rem;
		color: var(--signal);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}
	.prose :global(.creative-system) {
		display: grid;
		grid-template-columns: minmax(8rem, 1fr) minmax(3rem, 0.55fr) minmax(9rem, 1.1fr) minmax(3rem, 0.55fr) minmax(8rem, 1fr);
		grid-template-rows: 1fr auto;
		align-items: center;
		min-width: 43rem;
		padding: 1rem 0 0;
	}
	.prose :global(.system-column) {
		display: grid;
		gap: 0.7rem;
	}
	.prose :global(.column-label) {
		margin-bottom: 0.25rem;
		color: var(--ink-soft);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-align: left;
		text-transform: uppercase;
	}
	.prose :global(.system-node) {
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--line);
		font-size: 0.83rem;
		font-weight: 700;
	}
	.prose :global(.system-flow) {
		display: grid;
		gap: 2.55rem;
		padding-top: 1.8rem;
	}
	.prose :global(.system-flow i) {
		position: relative;
		display: block;
		height: 1px;
		overflow: visible;
		background: repeating-linear-gradient(90deg, var(--signal) 0 4px, transparent 4px 9px);
		background-size: 18px 1px;
		animation: line-travel 1.8s linear infinite;
	}
	.prose :global(.system-flow i::after) {
		position: absolute;
		top: -3px;
		right: 0;
		width: 6px;
		height: 6px;
		transform: rotate(45deg);
		border-top: 1px solid var(--signal);
		border-right: 1px solid var(--signal);
		content: "";
	}
	.prose :global(.identity-core) {
		position: relative;
		display: grid;
		aspect-ratio: 1;
		place-content: center;
		border: 1px solid var(--ink);
		border-radius: 50%;
		text-align: center;
	}
	.prose :global(.identity-core::before) {
		position: absolute;
		inset: 11%;
		border: 1px dashed var(--signal);
		border-radius: inherit;
		content: "";
		animation: orbit-turn 18s linear infinite;
	}
	.prose :global(.identity-core span) {
		position: relative;
		z-index: 1;
		color: var(--signal);
		font-size: 0.55rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.prose :global(.identity-core strong) {
		position: relative;
		z-index: 1;
		font-size: clamp(1rem, 2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.prose :global(.community-loop) {
		position: relative;
		grid-column: 1 / -1;
		margin: 2rem 7% 0;
		padding-top: 1rem;
		border-top: 1px solid var(--ink-soft);
		color: var(--ink-soft);
		font-size: 0.56rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-align: center;
		text-transform: uppercase;
	}
	.prose :global(.community-loop::before) {
		position: absolute;
		top: -4px;
		left: -1px;
		width: 7px;
		height: 7px;
		transform: rotate(-135deg);
		border-top: 1px solid var(--signal);
		border-right: 1px solid var(--signal);
		content: "";
	}
	.prose :global(.creative-surface-diagram figcaption) {
		max-width: 42rem;
		margin-top: 1.25rem;
		color: var(--ink-soft);
		font-size: 0.74rem;
		line-height: 1.5;
	}
	.prose :global(.creative-surface-diagram figcaption strong) { color: var(--ink); }
	@keyframes line-travel { to { background-position: 18px 0; } }
	.prose :global(.miku-context-grid) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: clamp(1.25rem, 3vw, 2.75rem);
		width: calc(100% + min(16vw, 12rem));
		margin: 3.25rem 0 4rem calc(min(8vw, 6rem) * -1);
		padding: clamp(1.25rem, 3vw, 2.5rem);
		background: #e9e9e3;
	}
	.prose :global(.miku-context-grid figure) {
		display: grid;
		grid-template-rows: clamp(26rem, 38vw, 36rem) auto;
		margin: 0;
	}
	.prose :global(.miku-context-grid img) {
		display: block;
		width: 100%;
		height: 100%;
		max-width: 100%;
		margin: 0 0 1rem;
		object-fit: contain;
		object-position: center center;
	}
	.prose :global(.miku-character img) {
		width: 80%;
		max-height: none;
		margin-right: auto;
		margin-left: auto;
	}
	.prose :global(.miku-software img) {
		width: 100%;
		image-rendering: auto;
	}
	.prose :global(.miku-context-grid figcaption) {
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.miku-context-grid figcaption a) {
		color: inherit;
	}
	.prose :global(.archive-figure) {
		width: min(100%, 34rem);
		margin: 3rem auto 4rem;
	}
	.prose :global(.archive-figure img) {
		display: block;
		width: 100%;
		max-width: 100%;
		margin: 0 0 1rem;
	}
	.prose :global(.archive-figure figcaption) {
		color: var(--ink-soft);
		font-family: "Atkinson", sans-serif;
		font-size: 0.75rem;
		line-height: 1.5;
	}
	.prose :global(.archive-figure figcaption a) {
		color: inherit;
	}
	.prose :global(.human-star-lineup) {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 0.65rem;
		width: calc(100% + min(24vw, 18rem));
		margin: 3rem 0 4rem calc(min(12vw, 9rem) * -1);
	}
	.prose :global(.human-star-lineup figure) {
		margin: 0;
	}
	.prose :global(.human-star-lineup img) {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		margin: 0 0 0.85rem;
		object-fit: cover;
		object-position: center top;
	}
	.prose :global(.human-star-lineup figcaption) {
		font-family: "Atkinson", sans-serif;
		font-size: 0.68rem;
		line-height: 1.35;
	}
