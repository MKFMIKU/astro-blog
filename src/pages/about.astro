---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="About | Kang-Fu Mei"
			description="Kang-Fu Mei is a research scientist and tech lead working on multimodal generative AI and world models."
		/>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<p class="eyebrow">About the author</p>
			<div class="about-grid">
				<h1>Kang-Fu Mei<br /><span>梅康夫</span></h1>
				<div class="bio">
					<p class="lead">
						Research Scientist and Tech Lead at Google DeepMind, working on reinforcement learning
						post-training for multimodal generative and world models.
					</p>
					<p>
						My work spans reward modeling, data, evaluation, and offline and online RL. I’m
						interested in systems that can simulate our dynamic world for creative control, more
						robust autonomous systems, and new entertainment experiences.
					</p>
					<p>
						I received my Ph.D. in Electrical and Computer Engineering from Johns Hopkins University,
						where I worked with Prof. Vishal M. Patel. Before that, I completed my M.S. at The Chinese
						University of Hong Kong, Shenzhen, advised by Prof. Rui Huang.
					</p>
					<div class="bio-links">
						<a href="https://kfmei.com">Research website ↗</a>
						<a href="https://scholar.google.com/citations?hl=en&user=e_nu_TIAAAAJ">Google Scholar ↗</a>
						<a href="https://x.com/KangfuM">X ↗</a>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		width: min(100%, var(--page));
		margin: 0 auto;
		padding: clamp(4.5rem, 10vw, 9rem) var(--gutter);
	}
	.about-grid {
		display: grid;
		margin-top: 2.5rem;
		grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.85fr);
		gap: clamp(3rem, 9vw, 10rem);
		align-items: start;
	}
	h1 {
		font-size: clamp(4.5rem, 9vw, 9rem);
		line-height: 0.88;
	}
	h1 span {
		color: var(--signal);
		font-size: 0.45em;
		letter-spacing: 0;
	}
	.bio {
		padding-top: 0.5rem;
	}
	.bio p {
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.55;
	}
	.bio .lead {
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--ink);
		color: var(--ink);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.5rem, 2.6vw, 2.25rem);
		line-height: 1.3;
	}
	.bio-links {
		display: grid;
		margin-top: 2.5rem;
		border-top: 1px solid var(--line);
	}
	.bio-links a {
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
	}
	@media (max-width: 800px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
