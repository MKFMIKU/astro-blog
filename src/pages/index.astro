---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="eyebrow">Independent research writing</p>
				<div class="intro-grid">
					<h1>Ideas at the edge of AI, media, and society.</h1>
					<p>
						Essays by Kang-Fu Mei on generative models, virtual worlds, and the cultural
						questions that emerge when intelligence becomes a creative medium.
					</p>
				</div>
			</section>

			<section class="latest" aria-labelledby="latest-heading">
				<div class="section-heading">
					<h2 id="latest-heading">Latest research note</h2>
					<span>{String(posts.length).padStart(2, '0')} publication</span>
				</div>
				<div class="post-list">
					{
						posts.map((post, index) => (
							<article class="post-card">
								<a class="post-image" href={`/${post.id}/`} aria-label={`Read ${post.data.title}`}>
									<img
										width={1200}
										height={600}
										src={post.data.heroImage}
										alt={`Illustration for ${post.data.title}`}
									/>
								</a>
								<div class="post-number">{String(index + 1).padStart(2, '0')}</div>
								<div class="post-copy">
									<div class="post-meta">
										<span>Essay</span>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3><a href={`/${post.id}/`}>{post.data.title}</a></h3>
									<p>{post.data.description}</p>
									<a class="read-link" href={`/${post.id}/`}>Read the essay <span>↗</span></a>
								</div>
							</article>
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro,
	.latest {
		width: min(100%, var(--page));
		margin: 0 auto;
		padding-right: var(--gutter);
		padding-left: var(--gutter);
	}
	.intro {
		padding-top: clamp(4.5rem, 10vw, 9rem);
		padding-bottom: clamp(5rem, 11vw, 10rem);
	}
	.intro-grid {
		display: grid;
		margin-top: 2.5rem;
		grid-template-columns: minmax(0, 3fr) minmax(16rem, 1fr);
		gap: clamp(2rem, 7vw, 8rem);
		align-items: end;
	}
	.intro h1 {
		max-width: 1050px;
		font-size: clamp(3.6rem, 7.7vw, 8rem);
		line-height: 0.91;
	}
	.intro-grid p {
		max-width: 28rem;
		margin: 0 0 0.35rem;
		color: var(--ink-soft);
		font-size: 1.05rem;
		line-height: 1.5;
	}
	.latest {
		border-top: 1px solid var(--ink);
	}
	.section-heading {
		display: flex;
		padding: 1rem 0 2.5rem;
		justify-content: space-between;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.section-heading h2 {
		font-size: inherit;
		font-weight: 700;
		letter-spacing: inherit;
	}
	.section-heading span {
		color: var(--ink-soft);
	}
	.post-list {
		display: grid;
		gap: 7rem;
	}
	.post-card {
		display: grid;
		grid-template-columns: minmax(0, 7fr) 3rem minmax(18rem, 3fr);
		gap: clamp(1.5rem, 3vw, 3.5rem);
		align-items: start;
	}
	.post-image {
		display: block;
		overflow: hidden;
		background: var(--paper-deep);
	}
	.post-image img {
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		transition: transform 500ms cubic-bezier(0.2, 0.75, 0.25, 1);
	}
	.post-image:hover img {
		transform: scale(1.015);
	}
	.post-number {
		padding-top: 0.15rem;
		color: var(--signal);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.post-meta {
		display: flex;
		margin-bottom: 1.35rem;
		gap: 1rem;
		color: var(--ink-soft);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}
	.post-meta span:first-child {
		color: var(--signal);
	}
	.post-copy h3 {
		margin-bottom: 1.4rem;
		font-size: clamp(2.2rem, 3.7vw, 4rem);
		line-height: 0.98;
	}
	.post-copy h3 a {
		text-decoration: none;
	}
	.post-copy p {
		color: var(--ink-soft);
		font-size: 1rem;
		line-height: 1.5;
	}
	.read-link {
		display: inline-flex;
		margin-top: 1rem;
		gap: 1.5rem;
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
	}
	.read-link span {
		transition: transform 160ms ease;
	}
	.read-link:hover span {
		transform: translate(0.2rem, -0.2rem);
	}
	@media (max-width: 900px) {
		.intro-grid,
		.post-card {
			grid-template-columns: 1fr;
		}
		.post-number {
			display: none;
		}
		.post-copy {
			max-width: 42rem;
		}
	}
	@media (max-width: 600px) {
		.intro h1 {
			font-size: clamp(3rem, 15vw, 4.5rem);
		}
		.intro {
			padding-top: 3.5rem;
			padding-bottom: 5rem;
		}
	}
</style>
